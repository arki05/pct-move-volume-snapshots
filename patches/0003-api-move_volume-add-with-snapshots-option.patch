diff --git a/src/test/run_snapshot_list_tests.pl b/src/test/run_snapshot_list_tests.pl
new file mode 100755
index 0000000..76e292c
--- /dev/null
+++ b/src/test/run_snapshot_list_tests.pl
@@ -0,0 +1,76 @@
+#!/usr/bin/perl
+
+# Tests for PVE::LXC::Config->snapshot_list_for_volume()
+
+use strict;
+use warnings;
+
+use lib qw(..);
+
+use Test::More tests => 5;
+
+use PVE::LXC::Config;
+
+my $conf = {
+    rootfs => 'local:103/subvol-103-disk-0.subvol',
+    snapshots => {
+        # deliberately unordered snaptimes; 'branched' shares snaptime
+        # ordering position via rollback history
+        newer => {
+            snaptime => 300,
+            rootfs => 'local:103/subvol-103-disk-0.subvol',
+            mp0 => 'other:103/subvol-103-disk-1.subvol,mp=/data',
+        },
+        oldest => {
+            snaptime => 100,
+            rootfs => 'local:103/subvol-103-disk-0.subvol',
+        },
+        middle => {
+            snaptime => 200,
+            rootfs => 'local:103/subvol-103-disk-0.subvol',
+        },
+        othervolume => {
+            snaptime => 250,
+            rootfs => 'local:103/subvol-103-disk-9.subvol',
+        },
+        novolume => {
+            snaptime => 260,
+        },
+        bindmount => {
+            snaptime => 270,
+            rootfs => 'local:103/subvol-103-disk-0.subvol',
+            mp0 => '/mnt/bindmount,mp=/mnt',
+        },
+    },
+};
+
+my @list = PVE::LXC::Config->snapshot_list_for_volume(
+    $conf, 'rootfs', 'local:103/subvol-103-disk-0.subvol',
+);
+is_deeply(
+    \@list,
+    ['oldest', 'middle', 'bindmount', 'newer'],
+    'snapshots referencing the volume, ordered by time',
+);
+
+@list = PVE::LXC::Config->snapshot_list_for_volume(
+    $conf, 'rootfs', 'local:103/subvol-103-disk-9.subvol',
+);
+is_deeply(\@list, ['othervolume'], 'other volume only matches its own snapshot');
+
+@list = PVE::LXC::Config->snapshot_list_for_volume(
+    $conf, 'mp0', 'other:103/subvol-103-disk-1.subvol',
+);
+is_deeply(\@list, ['newer'], 'mount point key is respected');
+
+@list = PVE::LXC::Config->snapshot_list_for_volume(
+    $conf, 'mp0', '/mnt/bindmount',
+);
+is_deeply(\@list, [], 'bind mounts are not volumes');
+
+@list = PVE::LXC::Config->snapshot_list_for_volume(
+    { rootfs => 'local:103/subvol-103-disk-0.subvol' },
+    'rootfs',
+    'local:103/subvol-103-disk-0.subvol',
+);
+is_deeply(\@list, [], 'config without snapshots yields empty list');
