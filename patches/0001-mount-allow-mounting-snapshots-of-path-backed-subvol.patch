From 64190a3df5709cc5504d2cc37f3c972005c81464 Mon Sep 17 00:00:00 2001
From: Julius Arkenberg <julius@rkenberg.de>
Date: Sun, 5 Jul 2026 20:17:43 +0200
Subject: [PATCH 1/3] mount: allow mounting snapshots of path-backed subvolumes

Mounting a snapshot of a 'subvol' format volume was hardcoded to zfspool
and died for every other storage type, which breaks snapshot-mode vzdump
backups and clone-from-snapshot for subvolume containers on btrfs (and
other path-backed subvolume storages, e.g. out-of-tree bcachefs).

For path-backed storages the snapshot path returned by
PVE::Storage::path() with a snapname is a read-only sibling directory
(`<volume>@<snapname>`), so a read-only bind mount is sufficient.
---
 src/PVE/LXC.pm | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/PVE/LXC.pm b/src/PVE/LXC.pm
index 3d217f2..61f7328 100644
--- a/src/PVE/LXC.pm
+++ b/src/PVE/LXC.pm
@@ -2248,6 +2248,19 @@ sub __mountpoint_mount {
                                 $mount_path,
                             ],
                         );
+                    } elsif ($scfg->{path}) {
+                        # The snapshot of a path-backed subvolume is a read-only
+                        # sibling directory of the form `<volume>@<snapname>`
+                        # (btrfs, bcachefs); $path already points at it, so a
+                        # read-only bind mount suffices.
+                        bindmount(
+                            $path,
+                            $parentfd,
+                            $last_dir // $rootdir,
+                            $mount_path,
+                            1,
+                            @extra_opts,
+                        );
                     } else {
                         die "cannot mount subvol snapshots for storage type '$scfg->{type}'\n";
                     }
